<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- documents other apps open with WordCraft by path (pickers need no permission) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:name=".WordcraftApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordCraft">

        <!-- The desktop-style front end (the egui app), packaged in this APK beside the Compose
             one: `crates/android-bridge` is its engine half's sibling and its window comes from
             winit inside `libwordcraft_android.so`. Android cannot swap one activity's UI for
             another's in place, so Pocket Mode hands off between the two activities rather than
             re-laying out in one; each declares `configChanges` so a rotation does not recreate it,
             and `launchMode="singleTask"` keeps exactly one of each (the hand-off's
             FLAG_ACTIVITY_CLEAR_TOP lands on it rather than stacking another). -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- winit's event loop needs to know which library to load and where to enter it. -->
            <meta-data android:name="android.app.lib_name" android:value="wordcraft_android" />
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- documents other apps open or edit with WordCraft -->
            <intent-filter android:label="@string/open_with">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.template" />
                <data android:mimeType="application/vnd.ms-word.document.macroEnabled.12" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- WordCraft's files handed to other apps (share, export) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
